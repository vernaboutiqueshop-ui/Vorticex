{
  "_comment": "NGROK FIXED: subsidy-gothic-take.ngrok-free.dev - Updated: May 4, 01:30",
  "version": 2,
  "public": true,
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://subsidy-gothic-take.ngrok-free.dev/api/:path*" },
    { "source": "/exercises/:path*", "destination": "https://subsidy-gothic-take.ngrok-free.dev/exercises/:path*" },
    { "source": "/uploads/:path*", "destination": "https://subsidy-gothic-take.ngrok-free.dev/uploads/:path*" },
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ]
}