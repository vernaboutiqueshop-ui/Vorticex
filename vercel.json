{
  "version": 2,
  "public": true,
  "headers": [
    { "source": "/gifs/(.*)", "headers": [{ "key": "Content-Type", "value": "image/gif" }, { "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/(.*\\.gif)", "headers": [{ "key": "Content-Type", "value": "image/gif" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://vorticexhealth-api.duckdns.org/api/:path*" },
    { "source": "/exercises/:path*", "destination": "https://vorticexhealth-api.duckdns.org/exercises/:path*" },
    { "source": "/uploads/:path*", "destination": "https://vorticexhealth-api.duckdns.org/uploads/:path*" },
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ]
}