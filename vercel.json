{
  "version": 2,
  "public": true,
  "redirects": [
    { "source": "/api/:path*", "destination": "https://pointing-planned-transformation-cemetery.trycloudflare.com/api/:path*", "permanent": false },
    { "source": "/exercises/:path*", "destination": "https://pointing-planned-transformation-cemetery.trycloudflare.com/exercises/:path*", "permanent": false },
    { "source": "/gifs/:path*", "destination": "https://pointing-planned-transformation-cemetery.trycloudflare.com/gifs/:path*", "permanent": false },
    { "source": "/uploads/:path*", "destination": "https://pointing-planned-transformation-cemetery.trycloudflare.com/uploads/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ]
}
