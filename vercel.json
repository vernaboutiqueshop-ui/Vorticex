{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": true,
  "github": {
    "enabled": false
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://peaceful-latter-evans-mold.trycloudflare.com/api/$1" },
    { "src": "/exercises/(.*)", "dest": "https://peaceful-latter-evans-mold.trycloudflare.com/exercises/$1" },
    { "src": "/gifs/(.*)", "dest": "https://peaceful-latter-evans-mold.trycloudflare.com/gifs/$1" },
    { "src": "/uploads/(.*)", "dest": "https://peaceful-latter-evans-mold.trycloudflare.com/uploads/$1" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ]
}
