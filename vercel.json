{
  "_comment": "API URL: subsidy-gothic-take.ngrok-free.dev - Updated: May 4, 2026 01:25 - Redeploy forced",
  "version": 2,
  "public": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://subsidy-gothic-take.ngrok-free.dev/api/:path*"
    },
    {
      "source": "/exercises/:path*",
      "destination": "https://subsidy-gothic-take.ngrok-free.dev/exercises/:path*"
    },
    {
      "source": "/gifs/:path*",
      "destination": "https://subsidy-gothic-take.ngrok-free.dev/gifs/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://subsidy-gothic-take.ngrok-free.dev/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/index.html"
    }
  ],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ]
}