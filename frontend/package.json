{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run copy-gifs",
    "copy-gifs": "node -e \"const fs=require('fs'),path=require('path'); const src=path.join(__dirname, 'public', 'gifs'), dst=path.join(__dirname, 'dist', 'gifs'); if (!fs.existsSync(dst)) fs.mkdirSync(dst, {recursive:true}); fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f), path.join(dst,f))); console.log('GIFs copied:', fs.readdirSync(dst).length);\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "firebase": "^12.12.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-muscle-highlighter": "^1.2.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
