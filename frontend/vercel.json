{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dream-counties-dale-quotations.trycloudflare.com/api/:path*" },
    { "source": "/exercises/:path*", "destination": "https://dream-counties-dale-quotations.trycloudflare.com/exercises/:path*" },
    { "source": "/gifs/:path*", "destination": "https://dream-counties-dale-quotations.trycloudflare.com/gifs/:path*" },
    { "source": "/uploads/:path*", "destination": "https://dream-counties-dale-quotations.trycloudflare.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
