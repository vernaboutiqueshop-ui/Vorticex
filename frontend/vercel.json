{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://behaviour-wonder-embassy-ambient.trycloudflare.com/api/:path*"
    },
    {
      "source": "/exercises/:path*",
      "destination": "https://behaviour-wonder-embassy-ambient.trycloudflare.com/exercises/:path*"
    },
    {
      "source": "/gifs/:path*",
      "destination": "https://behaviour-wonder-embassy-ambient.trycloudflare.com/gifs/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://behaviour-wonder-embassy-ambient.trycloudflare.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}